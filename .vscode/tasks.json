{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "vite: dev server",
            "type": "shell",
            "command": "npm.cmd",
            "args": ["run", "dev", "--", "--host", "127.0.0.1", "--port", "5173", "--strictPort"],
            "options": {
                "cwd": "${workspaceFolder}/life-style"
            },
            "isBackground": true,
            "problemMatcher": {
                "owner": "custom",
                "pattern": {
                    "regexp": ".*"
                },
                "background": {
                    "activeOnStart": true,
                    "beginsPattern": ".*",
                    "endsPattern": "http://127\\.0\\.0\\.1:5173/"
                }
            }
        }
    ]
}